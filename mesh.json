{
    "kernel": "^0.13",
    "parts": [
        {
            "kind": "extension",
            "id": "chrome",
            "version": "0.2.1",
            "entry": "src/chrome/index.ts",
            "kernel": "^0.13",
            "description": "The shell every site gets: a window list, a mode switch, and the area the windows live in.",
            "keywords": [
                "chrome",
                "shell",
                "core"
            ],
            "license": "UNLICENSED",
            "homepage": "https://github.com/FLYBYME/mesh-core"
        },
        {
            "kind": "application",
            "id": "catalog",
            "version": "0.2.0",
            "entry": "src/catalog/index.ts",
            "kernel": "^0.13",
            "mesh": [
                {
                    "package": "@flybyme/mesh-serve",
                    "version": "^0.1",
                    "contracts": [
                        "part.find",
                        "part.get",
                        "part.count",
                        "partVersion.find",
                        "partVersion.get",
                        "partVersion.count",
                        "catalog.resolve"
                    ]
                }
            ],
            "description": "Browse the platform catalog: inspect parts, versions, provenance, authors, repositories, and resolve version requirements.",
            "keywords": [
                "catalog",
                "parts",
                "versions",
                "packages",
                "core",
                "console"
            ],
            "license": "UNLICENSED",
            "homepage": "https://github.com/FLYBYME/mesh-core"
        },
        {
            "kind": "application",
            "id": "releases",
            "version": "0.2.0",
            "entry": "src/releases/index.ts",
            "kernel": "^0.13",
            "mesh": [
                {
                    "package": "@flybyme/mesh-serve",
                    "version": "^0.1",
                    "contracts": [
                        "release.find",
                        "release.get",
                        "release.count",
                        "site.find",
                        "site.get",
                        "site.count",
                        "cdn.compose",
                        "cdn.deploy"
                    ]
                }
            ],
            "description": "Compose immutable releases from version ranges, dry-run dependency resolutions, deploy to hostnames, and roll back.",
            "keywords": [
                "releases",
                "deploy",
                "rollback",
                "cdn",
                "sites",
                "core",
                "console"
            ],
            "license": "UNLICENSED",
            "homepage": "https://github.com/FLYBYME/mesh-core"
        },
        {
            "kind": "extension",
            "id": "auth",
            "version": "0.3.1",
            "entry": "src/auth/index.ts",
            "kernel": "^0.13",
            "mesh": [
                {
                    "package": "@flybyme/mesh-serve",
                    "version": "^0.1",
                    "contracts": [
                        "identity.ticket_issue",
                        "identity.whoami"
                    ]
                }
            ],
            "description": "The auth Extension: holds the session, attaches the ticket, and hands no credential to anyone.",
            "keywords": [
                "auth",
                "identity",
                "session",
                "core"
            ],
            "license": "UNLICENSED",
            "homepage": "https://github.com/FLYBYME/mesh-core"
        }
    ]
}
